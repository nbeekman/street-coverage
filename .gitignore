node_modules
dist
data/raw
*.local
.DS_Store

# tsc -b incremental state; machine-specific and regenerated on every build
*.tsbuildinfo

# Worktrees live here and contain their own node_modules. Without this, a
# `git add -A` from the primary checkout stages an entire nested checkout.
.claude/worktrees/

# Ride traces are personal location data. Never commit them.
data/rides/
public/rides/

# Coverage is derived from ride traces: which streets someone has ridden is
# location data too, and publishing it would undo the privacy clipping.
public/coverage/

# Local Netlify folder
.netlify
